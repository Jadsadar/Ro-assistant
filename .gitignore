# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
.next/
out/
/build
next-env.d.ts
*.tsbuildinfo

# generated by scripts/build-legacy-page.cjs (npm run legacy:page)
/public/legacy-calculator

# testing
/coverage
/test-results
/playwright-report
/blob-report

# env files (can opt-in for committing if needed)
.env*
!.env.example

# logs
*.log
.codex-*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# reference checkouts (cloned by npm run legacy:sync)
ro-assistant/
tong-calc-ro/

# python
venv/
__pycache__/

# editors / OS / tooling
.vscode/
.idea/
.DS_Store
Thumbs.db
*.pem
.claude/settings.local.json


# vercel
.vercel
